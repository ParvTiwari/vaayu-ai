# CPCB air quality data via data.gov.in — https://www.data.gov.in/
CPCB_API_KEY=

# NASA FIRMS active fire data — https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=

# LLM for advisory narrative + translation. Provider is auto-detected from the key:
#   Groq  key starts with  gsk_          (free — https://console.groq.com)
#   Anthropic key starts with sk-ant-api03-  (https://console.anthropic.com)
#   OpenAI key starts with  sk-
# Optional overrides:
#   LLM_PROVIDER = groq | anthropic | openai   (force a provider)
#   LLM_MODEL    = e.g. llama-3.3-70b-versatile (Groq) / claude-opus-4-8 (Anthropic)
#   LLM_BASE_URL = for any other OpenAI-compatible endpoint (OpenRouter, Together, …)
# Leave blank to use the deterministic CPCB guidance (no LLM). NOTE: an sk-ant-oat…
# value is an OAuth token, NOT an API key — it will not authenticate.
LLM_API_KEY=

# OpenAQ v3 — required (X-API-Key header is mandatory on all v3 endpoints).
# This is the only source of genuine historical AQI (CPCB's data.gov.in feed
# is live-snapshot only). Free signup: https://explore.openaq.org/register
OPENAQ_API_KEY=
