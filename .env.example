# CPCB air quality data via data.gov.in — https://www.data.gov.in/
CPCB_API_KEY=

# NASA FIRMS active fire data — https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_API_KEY=

# LLM provider for advisory narrative + translation (swap provider as needed)
LLM_API_KEY=

# OpenAQ v3 — required (X-API-Key header is mandatory on all v3 endpoints).
# This is the only source of genuine historical AQI (CPCB's data.gov.in feed
# is live-snapshot only). Free signup: https://explore.openaq.org/register
OPENAQ_API_KEY=
